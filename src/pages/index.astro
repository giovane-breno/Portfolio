<!doctype html><html lang="pt-BR"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width"><meta name="description" content="Portfólio de Giovane Barbosa, desenvolvedor full-stack especializado em produtos web, APIs e automação."><link rel="canonical" href="https://giovanebarbosa.dev/"><link rel="icon" href="/favicon.svg" type="image/svg+xml"><meta property="og:type" content="website"><meta property="og:locale" content="pt_BR"><meta property="og:site_name" content="Giovane Barbosa"><meta property="og:url" content="https://giovanebarbosa.dev/"><meta property="og:title" content="Giovane Barbosa — Desenvolvedor full-stack"><meta property="og:description" content="Construo produtos web, APIs e automações que resolvem problemas reais."><meta property="og:image" content="https://giovanebarbosa.dev/images/branding/giovanebarbosa-dev-logo.png"><meta property="og:image:alt" content="Logo Giovane Barbosa Dev"><meta name="twitter:card" content="summary"><meta name="twitter:title" content="Giovane Barbosa — Desenvolvedor full-stack"><meta name="twitter:description" content="Construo produtos web, APIs e automações que resolvem problemas reais."><meta name="twitter:image" content="https://giovanebarbosa.dev/images/branding/giovanebarbosa-dev-logo.png"><script type="application/ld+json" set:html={JSON.stringify({ '@context':'https://schema.org', '@type':'Person', name:'Giovane Barbosa', jobTitle:'Desenvolvedor full-stack', url:'https://giovanebarbosa.dev/', image:'https://giovanebarbosa.dev/images/branding/giovanebarbosa-dev-logo.png', sameAs:['https://github.com/giovane-breno','https://www.linkedin.com/in/giovane-breno/'], knowsAbout:['Laravel','PHP','React','Vue','TypeScript','Docker','MySQL','REST APIs'] })}></script><title>Giovane Barbosa — Desenvolvedor full-stack</title></head><body>
<a class="skip" href="#conteudo">Pular para o conteúdo</a>
<header><div class="container"><nav aria-label="Navegação principal"><a class="brand" href="#inicio">GB<b>•</b></a><div class="nav"><a href="#projetos" data-pt="Projetos" data-en="Projects">Projetos</a><a href="#experiencia" data-pt="Experiência" data-en="Experience">Experiência</a><a href="#sobre" data-pt="Sobre" data-en="About">Sobre</a><a href="#contato" data-pt="Contato" data-en="Contact">Contato</a></div><button class="lang" id="lang-toggle" type="button">EN</button></nav></div></header>
<main id="conteudo">
<section class="hero container" id="inicio"><div class="reveal"><div class="eyebrow" data-pt="Desenvolvedor full-stack · São José dos Campos" data-en="Full-stack developer · São José dos Campos">Desenvolvedor full-stack · São José dos Campos</div><h1 data-pt="Construo sistemas que <em>resolvem.</em>" data-en="I build systems that <em>solve.</em>">Construo sistemas que <em>resolvem.</em></h1><p class="hero-copy" data-pt="Sou Giovane Barbosa, desenvolvedor full-stack. Transformo necessidades reais em produtos web claros, confiáveis e prontos para operação — da primeira tela ao deploy." data-en="I am Giovane Barbosa, a full-stack developer. I turn real needs into clear, reliable web products ready for operation — from the first screen to deployment.">Sou Giovane Barbosa, desenvolvedor full-stack. Transformo necessidades reais em produtos web claros, confiáveis e prontos para operação — da primeira tela ao deploy.</p><div class="actions"><a class="button primary" href="#projetos" data-pt="Ver projetos ↓" data-en="See projects ↓">Ver projetos ↓</a><a class="button" href="mailto:me@giovanebarbosa.dev" data-pt="Entrar em contato ↗" data-en="Get in touch ↗">Entrar em contato ↗</a><a class="button" href="https://github.com/giovane-breno" target="_blank" rel="noreferrer">GitHub ↗</a><a class="button" href="https://www.linkedin.com/in/giovane-breno/" target="_blank" rel="noreferrer">LinkedIn ↗</a></div></div><div class="portrait reveal"><img src="https://avatars.githubusercontent.com/u/57039322?v=4" alt="Foto de Giovane Barbosa" width="400" height="400"><span class="portrait-label" data-pt="5+ anos construindo" data-en="5+ years building">5+ anos construindo</span></div></section>
<section class="process"><div class="container"><div class="proof reveal"><div><strong>Laravel · PHP</strong><span>Backend & APIs</span></div><div><strong>React · Vue</strong><span>Interfaces & produtos</span></div><div><strong>Docker · DevOps</strong><span>Deploy & operações</span></div><div><strong>IA aplicada</strong><span>Automação & produtividade</span></div><div><strong>REST APIs</strong><span>Integração de sistemas</span></div><div><strong>SQL · MySQL</strong><span>Dados & persistência</span></div></div><div class="intro reveal" style="margin-top:5rem;margin-bottom:1.2rem"><h2 data-pt="Como trabalho." data-en="How I work.">Como trabalho.</h2><p data-pt="Um processo direto para transformar uma necessidade em uma solução utilizável." data-en="A direct process for turning a need into a usable solution.">Um processo direto para transformar uma necessidade em uma solução utilizável.</p></div><div class="process-grid"><div class="step reveal"><small>01</small><h3 data-pt="Entendo o problema" data-en="Understand the problem">Entendo o problema</h3><p data-pt="Alinho contexto, objetivos e prioridades antes de escrever código." data-en="I align context, goals and priorities before writing code.">Alinho contexto, objetivos e prioridades antes de escrever código.</p></div><div class="step reveal"><small>02</small><h3 data-pt="Planejo a solução" data-en="Plan the solution">Planejo a solução</h3><p data-pt="Organizo fluxos, arquitetura, dados e próximos passos." data-en="I organize flows, architecture, data and next steps.">Organizo fluxos, arquitetura, dados e próximos passos.</p></div><div class="step reveal"><small>03</small><h3 data-pt="Desenvolvo" data-en="Build">Desenvolvo</h3><p data-pt="Construo interfaces, APIs e integrações focadas no uso real." data-en="I build interfaces, APIs and integrations focused on real use.">Construo interfaces, APIs e integrações focadas no uso real.</p></div><div class="step reveal"><small>04</small><h3 data-pt="Publico e acompanho" data-en="Launch & support">Publico e acompanho</h3><p data-pt="Cuido do deploy, ajustes e evolução do produto." data-en="I take care of deployment, adjustments and product evolution.">Cuido do deploy, ajustes e evolução do produto.</p></div></div></div></section>
<section id="projetos"><div class="container"><div class="intro reveal"><h2 data-pt="Projetos que<br>viraram produtos." data-en="Projects that<br>became products.">Projetos que<br>viraram produtos.</h2><p data-pt="Uma seleção de sistemas que conectam interface, regras de negócio, dados e operação." data-en="A selection of systems that connect interface, business rules, data and operations.">Uma seleção de sistemas que conectam interface, regras de negócio, dados e operação.</p></div><div class="projects">{projects.map((project)=><article class="project reveal"><div class="project-media"><span class="number">{project.number}</span><a href={project.link} target="_blank" rel="noreferrer"><img src={project.image} alt={project.alt} loading="lazy" width="800" height="500"></a></div><div class="project-body"><div class="meta" data-pt={project.meta} data-en={project.meta}>{project.meta}</div><h3>{project.title}</h3><p data-pt={project.pt} data-en={project.en}>{project.pt}</p><div class="impact"><span data-pt="Impacto" data-en="Impact">Impacto</span><span data-pt={project.impactPt} data-en={project.impactEn}>{project.impactPt}</span></div><div class="project-footer"><div class="chips">{project.tags.map(tag=><span class="chip">{tag}</span>)}</div><a class="link" href={project.link} target="_blank" rel="noreferrer" data-pt={project.linkText} data-en={project.linkEn}>{project.linkText}</a></div></div></article>)}</div><div class="intro reveal" style="margin-top:5rem;margin-bottom:1.2rem"><h2 style="font-size:2rem" data-pt="Outros trabalhos." data-en="Other work.">Outros trabalhos.</h2><p data-pt="Projetos menores que mostram minha base em APIs, formulários e arquitetura web." data-en="Smaller projects that show my foundation in APIs, forms and web architecture.">Projetos menores que mostram minha base em APIs, formulários e arquitetura web.</p></div><div class="more">{more.map(item=><article class="reveal"><h3 data-pt={item[0]} data-en={item[2]}>{item[0]}</h3><p data-pt={item[1]} data-en={item[3]}>{item[1]}</p><a href={item[4]} target="_blank" rel="noreferrer" data-pt="Ver repositório ↗" data-en="View repository ↗">Ver repositório ↗</a></article>)}</div></div></section>
<section id="experiencia"><div class="container"><div class="intro reveal"><div><div class="eyebrow" data-pt="Trajetória profissional" data-en="Professional journey">Trajetória profissional</div><h2 data-pt="Experiência." data-en="Experience.">Experiência.</h2></div><p data-pt="Uma trajetória que conecta desenvolvimento de produto, suporte técnico e automação — sempre com foco em resolver problemas reais." data-en="A career connecting product development, technical support and automation — always focused on solving real problems.">Uma trajetória que conecta desenvolvimento de produto, suporte técnico e automação — sempre com foco em resolver problemas reais.</p></div><div class="experience">{roles.map(role=><article class:list={['role','reveal',role.current&&'current']}><time data-pt={role.date} data-en={role.date}>{role.date}<span data-pt={role.duration} data-en={role.duration}>{role.duration}</span></time><div><h3 data-pt={role.title} data-en={role.titleEn}>{role.title}{role.current&&<span class="badge" data-pt="Atual" data-en="Current">Atual</span>}</h3>{role.company&&<p class="company" data-pt={role.company} data-en={role.companyEn}>{role.company}</p>}<p class="location" data-pt={role.location} data-en={role.locationEn}>{role.location}</p><p data-pt={role.text} data-en={role.textEn}>{role.text}</p>{role.tags&&<div class="chips">{role.tags.map(tag=><span class="chip">{tag}</span>)}</div>}</div></article>)}</div></div></section>
<section id="sobre"><div class="container"><div class="intro reveal"><h2 data-pt="Sobre e<br>formação." data-en="About &<br>education.">Sobre e<br>formação.</h2><p data-pt="Base técnica, prática e acadêmica para transformar problemas reais em software útil." data-en="Technical, practical and academic foundations for turning real problems into useful software.">Base técnica, prática e acadêmica para transformar problemas reais em software útil.</p></div><div class="education"><article class="reveal"><div class="eyebrow" data-pt="Graduação · 2022 — 2023" data-en="Degree · 2022 — 2023">Graduação · 2022 — 2023</div><h3 data-pt="Análise e Desenvolvimento de Sistemas" data-en="Systems Analysis and Development">Análise e Desenvolvimento de Sistemas</h3><p>UNIP — Universidade Paulista</p><p data-pt="Formação em desenvolvimento de sistemas, banco de dados, engenharia de software e análise de requisitos." data-en="Training in systems development, databases, software engineering and requirements analysis.">Formação em desenvolvimento de sistemas, banco de dados, engenharia de software e análise de requisitos.</p><div class="chips"><span class="chip">Software</span><span class="chip">Banco de dados</span></div></article><article class="reveal"><div class="eyebrow" data-pt="Ensino técnico · 2019 — 2021" data-en="Technical education · 2019 — 2021">Ensino técnico · 2019 — 2021</div><h3 data-pt="Técnico em Informática" data-en="IT Technician">Técnico em Informática</h3><p>Colégio Univap — Unidade Centro</p><p data-pt="Base prática em programação, banco de dados, desenvolvimento web e fundamentos de infraestrutura." data-en="Practical foundation in programming, databases, web development and infrastructure fundamentals.">Base prática em programação, banco de dados, desenvolvimento web e fundamentos de infraestrutura.</p><div class="chips"><span class="chip">Programação</span><span class="chip">Web</span></div></article></div></div></section>
<section class="contact-panel" id="contato"><div class="container contact reveal"><div><div class="eyebrow" data-pt="Próximo projeto?" data-en="Next project?">Próximo projeto?</div><h2 data-pt="Vamos conversar sobre o que você quer construir." data-en="Let’s talk about what you want to build.">Vamos conversar sobre o que você quer construir.</h2></div><a class="button" href="mailto:me@giovanebarbosa.dev">me@giovanebarbosa.dev ↗</a></div></section>
</main><footer><div class="container footer"><span>© 2026 Giovane Barbosa</span><div class="socials"><a href="https://github.com/giovane-breno" target="_blank" rel="noreferrer">GitHub</a><a href="https://www.linkedin.com/in/giovane-breno/" target="_blank" rel="noreferrer">LinkedIn</a><a href="mailto:me@giovanebarbosa.dev">Email</a></div></div></footer>
<script>
  const observer=new IntersectionObserver(entries=>entries.forEach(entry=>{if(entry.isIntersecting)entry.target.classList.add('visible')}),{threshold:.1});
  document.querySelectorAll('.reveal').forEach(element=>observer.observe(element));
  const nodes=document.querySelectorAll('[data-pt][data-en]');
  const button=document.querySelector('#lang-toggle');
  function setLanguage(language){nodes.forEach(node=>node.innerHTML=node.dataset[language]);document.documentElement.lang=language==='en'?'en':'pt-BR';document.title=language==='en'?'Giovane Barbosa — Full-stack Developer':'Giovane Barbosa — Desenvolvedor full-stack';button.textContent=language==='en'?'PT':'EN';button.setAttribute('aria-label',language==='en'?'Mudar para português':'Switch to English');localStorage.setItem('portfolio-lang',language)}
  button.addEventListener('click',()=>setLanguage(document.documentElement.lang==='en'?'pt':'en'));
  const saved=localStorage.getItem('portfolio-lang');const system=(navigator.language||'pt-BR').toLowerCase();setLanguage(saved||(system.startsWith('en')?'en':'pt'));
</script></body></html>
